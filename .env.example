# Copie para .env e preencha (chmod 600 .env). NUNCA publique este arquivo.
# Pasta onde as fotos são gravadas (use aspas se o caminho tiver espaço)
CAMERA_IMAGES_DIR="/caminho/para/cameraImages"

# WAHA (WhatsApp). Gere valores longos e aleatórios, ex.: openssl rand -hex 24
WAHA_API_KEY=troque-por-um-valor-aleatorio
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-por-uma-senha
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=troque-por-uma-senha
WHATSAPP_DEFAULT_ENGINE=NOWEB
WHATSAPP_START_SESSION=default
WAHA_PRINT_QR=false

# Usuário:grupo dono das pastas do projeto (resultado de: echo "$(id -u):$(id -g)")
UID_GID=1000:1000
